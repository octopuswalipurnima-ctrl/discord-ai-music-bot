# Discord application
DISCORD_TOKEN=replace_me
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
# Optional: use a test server for instant command registration. Leave blank for global commands.
DISCORD_DEV_GUILD_ID=

# PostgreSQL (one connection pool per shard worker)
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgres://musicbot:replace_with_a_long_random_password@localhost:5432/musicbot
DB_POOL_MAX=6

# Redis is required for distributed voice-session leases, queue recovery and rate limits.
REDIS_URL=redis://localhost:6379

# Production sharding. SHARD_COUNT=auto asks Discord for its recommended shard count.
# npm run dev uses one local worker; Docker production starts the shard manager.
SHARDING_ENABLED=true
SHARD_COUNT=auto

# Dashboard OAuth callback must exactly match the URL configured in the Discord Developer Portal.
DASHBOARD_URL=http://localhost:3000
DASHBOARD_CALLBACK_URL=http://localhost:3000/auth/callback
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
PORT=3000

# Dashboard and anti-abuse protections
DASHBOARD_RATE_LIMIT_MAX=60
DASHBOARD_RATE_LIMIT_WINDOW_MS=60000
# Optional Prometheus endpoint auth. /metrics is disabled (404) when blank.
METRICS_TOKEN=

# Comma-separated trusted hosts serving audio files/streams that you have permission to play.
# The first version deliberately rejects YouTube/Spotify/Gaana page URLs and arbitrary redirects.
AUDIO_ALLOWED_HOSTS=

# Optional limits
MAX_QUEUE_SIZE=100
DEFAULT_VOLUME=70

# Optional OpenAI-compatible chat completion endpoint for natural-language music requests.
# Leave blank to use the built-in local intent parser. The model can only select from your server catalogue.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
